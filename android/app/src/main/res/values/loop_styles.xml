<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LoopHeading">
        <item name="android:textColor">#E9ECF3</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="LoopSectionHeader">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="LoopSectionTitle">
        <item name="android:textColor">#E9ECF3</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="LoopSectionSummary">
        <item name="android:textColor">#98A0B3</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="LoopChevron">
        <item name="android:textColor">#98A0B3</item>
        <item name="android:textSize">22sp</item>
        <item name="android:text">›</item>
        <item name="android:paddingStart">10dp</item>
    </style>
    <style name="Theme.HoloLoop" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="colorPrimary">#5B8CFF</item>
        <item name="colorOnPrimary">#08101F</item>
        <item name="colorSecondaryContainer">#1E2534</item>
        <item name="colorOnSecondaryContainer">#DFE8FF</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
